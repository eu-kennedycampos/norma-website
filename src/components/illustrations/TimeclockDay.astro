---
/**
 * Um dia na régua: das 6h às 22h, as marcações caem uma a uma (entrada, almoço, volta, saída),
 * o intervalo trabalhado se preenche e o espelho do dia fecha com o esquadro.
 */
const hours = Array.from({ length: 17 }, (_, i) => 6 + i);
// `side`: para que lado o rótulo escreve. Almoço e volta ficam colados, então se afastam.
const marks = [
  { at: 8, label: '08:00', kind: 'entrada', side: 'right' },
  { at: 12, label: '12:02', kind: 'almoço', side: 'left' },
  { at: 13, label: '13:01', kind: 'volta', side: 'right' },
  { at: 17.25, label: '17:15', kind: 'saída', side: 'right' },
];
const position = (hour: number) => `${((hour - 6) / 16) * 100}%`;
---

<figure
  class="day"
  aria-label="Um dia de marcações de ponto: entrada às 8h, almoço às 12h02, volta às 13h01 e saída às 17h15"
>
  <div class="day__head">
    <span class="label">Espelho do dia</span>
    <span class="day__total mono">8h16 trabalhadas</span>
  </div>

  <div class="day__ruler" aria-hidden="true">
    <span
      class="day__work"
      style={`left: ${position(8)}; width: calc(${position(12)} - ${position(8)})`}
    ></span>
    <span
      class="day__work day__work--late"
      style={`left: ${position(13)}; width: calc(${position(17.25)} - ${position(13)})`}
    ></span>
    {marks.map((mark, index) => (
      <span
        class:list={['day__mark', `day__mark--${mark.side}`]}
        style={`left: ${position(mark.at)}; --i: ${index}`}
      >
        <span class="day__mark-time mono">{mark.label}</span>
        <span class="day__mark-kind">{mark.kind}</span>
      </span>
    ))}
  </div>

  <div class="day__hours mono" aria-hidden="true">
    {hours
      .filter((h) => h % 2 === 0)
      .map((h) => (
        <span>{h}h</span>
      ))}
  </div>

  <div class="day__foot" aria-hidden="true">
    <span>Banco de horas</span>
    <span class="mono">+0h16</span>
    <span class="day__seal">assinado ¬</span>
  </div>
</figure>

<style>
  .day {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--c-ink-2);
    border: 1px solid var(--c-line-dark);
  }

  .day__head,
  .day__foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .day__total {
    font-size: 0.875rem;
    color: var(--c-ruler);
  }

  .day__ruler {
    position: relative;
    height: 7.5rem;
    margin-top: 0.5rem;
    background-image:
      repeating-linear-gradient(90deg, var(--c-line-dark-2) 0 1px, transparent 1px calc(100% / 16)),
      linear-gradient(var(--c-line-dark-2), var(--c-line-dark-2));
    background-size:
      100% 0.75rem,
      100% 1px;
    background-position:
      left bottom,
      left bottom;
    background-repeat: no-repeat;
  }

  .day__work {
    position: absolute;
    bottom: 0;
    height: 0.75rem;
    background: var(--c-ruler);
    transform-origin: left;
    animation: fill 0.8s var(--ease-tool) both;
    animation-delay: 1.1s;
  }

  .day__work--late {
    animation-delay: 2.1s;
  }

  .day__mark {
    position: absolute;
    bottom: 0;
    width: 2px;
    height: 100%;
    background: var(--c-paper);
    transform-origin: bottom;
    animation: stamp 0.5s var(--ease-snap) both;
    animation-delay: calc(0.4s + var(--i) * 0.45s);
  }

  .day__mark-time,
  .day__mark-kind {
    position: absolute;
    left: 0.5rem;
    white-space: nowrap;
  }

  .day__mark--left .day__mark-time,
  .day__mark--left .day__mark-kind {
    left: auto;
    right: 0.5rem;
    text-align: right;
  }

  .day__mark-time {
    top: 0;
    font-size: 0.75rem;
    color: var(--c-paper);
  }

  .day__mark-kind {
    top: 1.125rem;
    font-size: 0.75rem;
    color: var(--c-steel);
  }

  .day__hours {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    color: var(--c-steel);
  }

  .day__foot {
    padding-top: 1rem;
    border-top: 1px solid var(--c-line-dark);
    font-size: 0.875rem;
    color: var(--c-text-dark-dim);
  }

  .day__seal {
    margin-left: auto;
    padding: 0.25rem 0.5rem;
    background: var(--c-ruler);
    color: var(--c-ink);
    font-weight: 700;
    animation: seal 0.5s var(--ease-snap) 3s both;
  }

  @keyframes stamp {
    from {
      transform: scaleY(0);
      opacity: 0;
    }
  }

  @keyframes fill {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes seal {
    from {
      transform: scale(0.6);
      opacity: 0;
    }
  }
</style>
