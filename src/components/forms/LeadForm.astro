---
/**
 * Formulário de lead. Curto de propósito: cada campo a mais derruba a conversão do anúncio.
 * O envio (endpoint, WhatsApp ou aviso) e os eventos ficam em src/scripts/lead-form.ts.
 */
import { site } from '~/config/site';
import type { LeadInterest } from '~/data/types';

interface Props {
  id: string;
  interest: LeadInterest;
  submitLabel: string;
  /** Pergunta "quantas pessoas" — usada na lista de espera do ponto. */
  askTeamSize?: boolean;
  /** Mostra o campo aberto "o que dá trabalho hoje". */
  askMessage?: boolean;
  messagePlaceholder?: string;
}

const {
  id,
  interest,
  submitLabel,
  askTeamSize = false,
  askMessage = true,
  messagePlaceholder = 'Ex.: fechamos a comissão da equipe numa planilha de 14 abas.',
} = Astro.props;
const field = (name: string) => `${id}-${name}`;
---

<form
  id={id}
  class="lead-form"
  method="post"
  action="#"
  data-lead-form
  data-interest={interest}
  data-whatsapp={site.whatsapp ?? undefined}
  data-email={site.email ?? undefined}
>
  <div class="lead-form__row">
    <label class="lead-form__field" for={field('name')}>
      <span>Nome</span>
      <input id={field('name')} name="name" type="text" autocomplete="name" required maxlength="120" />
    </label>
    <label class="lead-form__field" for={field('company')}>
      <span>Empresa</span>
      <input
        id={field('company')}
        name="company"
        type="text"
        autocomplete="organization"
        required
        maxlength="160"
      />
    </label>
  </div>

  <div class="lead-form__row">
    <label class="lead-form__field" for={field('contact')}>
      <span>WhatsApp ou e-mail</span>
      <input
        id={field('contact')}
        name="contact"
        type="text"
        required
        maxlength="160"
        aria-describedby={field('contact-hint')}
      />
      <small id={field('contact-hint')} class="lead-form__hint">
        Respondemos por onde você preferir.
      </small>
    </label>
    {askTeamSize && (
      <label class="lead-form__field" for={field('team')}>
        <span>Pessoas na equipe</span>
        <select id={field('team')} name="team_size">
          <option value="">Selecione</option>
          <option>Até 10</option>
          <option>11 a 50</option>
          <option>51 a 200</option>
          <option>201 a 500</option>
          <option>Mais de 500</option>
        </select>
      </label>
    )}
  </div>

  {askMessage && (
    <label class="lead-form__field" for={field('message')}>
      <span>O que dá trabalho hoje</span>
      <textarea
        id={field('message')}
        name="message"
        rows="4"
        maxlength="2000"
        placeholder={messagePlaceholder}
      />
    </label>
  )}

  <!-- Armadilha para robôs: invisível para pessoas e leitores de tela. -->
  <div class="lead-form__trap" aria-hidden="true">
    <label for={field('website')}>Site</label>
    <input id={field('website')} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" class="lead-form__submit">
    <span>{submitLabel}</span>
    <span class="lead-form__mark" aria-hidden="true">
      ¬
    </span>
  </button>

  <p class="lead-form__status" data-form-status role="status" aria-live="polite"></p>

  <p class="lead-form__legal">
    Ao enviar, você concorda com a <a href="/privacidade">Política de privacidade</a>.
  </p>
</form>

<script>
  import '~/scripts/lead-form.ts';
</script>

<style>
  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lead-form__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    gap: 1rem;
  }

  .lead-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .lead-form input,
  .lead-form select,
  .lead-form textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.875rem 1rem;
    border: 2px solid var(--c-ink);
    border-radius: 0;
    background: var(--bg-raised);
    color: var(--c-ink);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    appearance: none;
  }

  .lead-form select {
    background-image:
      linear-gradient(45deg, transparent 50%, var(--c-ink) 50%),
      linear-gradient(135deg, var(--c-ink) 50%, transparent 50%);
    background-position:
      calc(100% - 1.25rem) 50%,
      calc(100% - 0.875rem) 50%;
    background-size: 0.375rem 0.375rem;
    background-repeat: no-repeat;
    padding-right: 2.5rem;
  }

  .lead-form textarea {
    resize: vertical;
    min-height: 7rem;
  }

  .lead-form ::placeholder {
    color: var(--fg-mute);
  }

  .lead-form input:focus-visible,
  .lead-form select:focus-visible,
  .lead-form textarea:focus-visible {
    outline: 3px solid var(--c-ink);
    outline-offset: 2px;
  }

  .lead-form [aria-invalid='true'],
  .lead-form :user-invalid {
    border-color: var(--c-mark);
  }

  .lead-form__hint {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--fg-mute);
  }

  .lead-form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .lead-form__submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.75rem;
    padding: 0 1.5rem;
    border: 0;
    background: var(--c-ink);
    color: var(--c-paper);
    font-size: 1.125rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.25s ease;
  }

  .lead-form__submit:hover {
    background: var(--c-line-dark);
  }

  .lead-form__submit:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .lead-form__mark {
    color: var(--c-ruler);
    font-size: 1.5rem;
    transition: transform 0.35s var(--ease-tool);
  }

  .lead-form__submit:hover .lead-form__mark {
    transform: translateX(0.375rem);
  }

  .lead-form[aria-busy='true'] .lead-form__mark {
    animation: busy 0.9s var(--ease-tool) infinite;
  }

  .lead-form__status:empty {
    display: none;
  }

  .lead-form__status {
    padding: 0.875rem 1rem;
    border: 2px solid var(--c-ink);
    font-weight: 600;
  }

  .lead-form__status[data-tone='error'] {
    border-color: var(--c-mark);
  }

  .lead-form__legal {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--fg-mute);
  }

  @keyframes busy {
    50% {
      transform: translateX(0.5rem);
    }
  }
</style>
