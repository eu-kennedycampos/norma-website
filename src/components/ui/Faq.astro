---
/**
 * Perguntas frequentes em <details>: abre e fecha sem JavaScript, o texto está no HTML
 * (o Google lê) e o mesmo conteúdo alimenta o FAQPage em JSON-LD na página.
 */
import type { FaqItem } from '~/data/types';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq">
  {items.map((item, index) => (
    <details class="faq__item" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
      <summary class="faq__question">
        <span>{item.question}</span>
        <span class="faq__icon" aria-hidden="true" />
      </summary>
      <p class="faq__answer">{item.answer}</p>
    </details>
  ))}
</div>

<style>
  .faq {
    border-top: 1px solid var(--line);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
    padding-block: 1.25rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  /* Um esquadro que gira: fechado aponta para baixo, aberto encaixa para cima. */
  .faq__icon {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.4s var(--ease-tool);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    background: var(--accent);
  }

  .faq__icon::before {
    inset: 0 0 auto 0;
    height: 4px;
  }

  .faq__icon::after {
    inset: 0 0 0 auto;
    width: 4px;
    height: 60%;
  }

  .faq__item[open] .faq__icon {
    transform: rotate(180deg);
  }

  .faq__answer {
    max-width: 48rem;
    padding-bottom: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--fg-dim);
  }

  .faq__question:hover {
    color: var(--fg);
  }
</style>
