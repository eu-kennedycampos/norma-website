---
/**
 * Aviso de cookies. Só existe quando há GTM: sem ferramenta de medição, não há o que consentir.
 * Fica fechado no HTML e o script abre só para quem ainda não escolheu — assim ele não pisca
 * para quem já respondeu e não aparece para robôs.
 */
import { PUBLIC_GTM_ID } from 'astro:env/client';

const enabled = Boolean(PUBLIC_GTM_ID?.trim());
---

{enabled && (
  <section class="consent" data-consent hidden aria-labelledby="consent-title">
    <p id="consent-title" class="consent__title">
      Cookies de medição
    </p>
    <p class="consent__text">
      Usamos cookies para entender de onde vêm as visitas e medir nossos anúncios. Nada é ativado sem a sua
      permissão. <a href="/privacidade">Saiba mais</a>.
    </p>
    <div class="consent__actions">
      <button type="button" class="consent__button consent__button--accept" data-consent-choice="granted">
        Aceitar
      </button>
      <button type="button" class="consent__button" data-consent-choice="denied">
        Recusar
      </button>
    </div>
  </section>
)}

<script>
  import { readConsent, saveConsent, type ConsentChoice } from '~/lib/consent';

  const banner = document.querySelector<HTMLElement>('[data-consent]');
  if (banner && readConsent() === null) {
    banner.hidden = false;
    banner.querySelectorAll<HTMLButtonElement>('[data-consent-choice]').forEach((button) => {
      button.addEventListener('click', () => {
        saveConsent(button.dataset.consentChoice as ConsentChoice);
        banner.dataset.closing = 'true';
        window.setTimeout(() => (banner.hidden = true), 300);
      });
    });
  }
</script>

<style>
  .consent {
    position: fixed;
    left: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(26rem, calc(100% - 2rem));
    padding: 1.25rem;
    background: var(--c-paper);
    color: var(--c-ink);
    border: 1px solid var(--c-ink);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.35);
    animation: consent-in 0.5s var(--ease-tool);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .consent[hidden] {
    display: none;
  }

  .consent[data-closing='true'] {
    opacity: 0;
    transform: translateY(1rem);
  }

  .consent__title {
    font-weight: 800;
  }

  .consent__text {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--c-text-light-dim);
  }

  .consent__actions {
    display: flex;
    gap: 0.5rem;
  }

  .consent__button {
    flex: 1;
    min-height: 2.75rem;
    border: 1px solid var(--c-ink);
    background: transparent;
    font-weight: 700;
    cursor: pointer;
  }

  .consent__button--accept {
    background: var(--c-ink);
    color: var(--c-paper);
  }

  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  /* No celular, sobe acima da barra de ação. */
  @media (max-width: 47.99rem) {
    .consent {
      bottom: calc(5.25rem + env(safe-area-inset-bottom));
      left: 0.75rem;
      width: calc(100% - 1.5rem);
    }
  }
</style>
