# Endereço público do site, sem barra no fim. Usado no canonical, no sitemap e no Open Graph.
SITE_URL=https://www.exemplo.com.br

# Google Tag Manager (GTM-XXXXXXX). Vazio = nenhum script de terceiro é carregado.
PUBLIC_GTM_ID=

# Para onde o formulário envia o lead (POST JSON). Vazio = o envio cai no WhatsApp.
PUBLIC_LEAD_ENDPOINT=

# WhatsApp comercial, só dígitos e com DDI (ex.: 5543999999999).
PUBLIC_WHATSAPP=

# E-mail de contato e do encarregado de dados (LGPD).
PUBLIC_CONTACT_EMAIL=

# Cookies e consentimento (src/consent). "basic": o GTM só carrega depois de alguma permissão.
# "advanced": o GTM carrega sempre e, sem permissão, manda só sinais sem cookies ao Google.
PUBLIC_CONSENT_MODE=basic

# Para onde vai o registro de cada escolha sobre cookies (POST JSON) — a prova do consentimento.
PUBLIC_CONSENT_ENDPOINT=

# true mostra o aviso de cookies mesmo sem GTM, para ver e testar.
PUBLIC_CONSENT_PREVIEW=false
